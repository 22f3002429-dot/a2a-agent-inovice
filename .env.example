# Copy these into your host's environment variable settings (never commit real keys)
OPENROUTER_API_KEY=sk-or-xxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini
# Exact public base URL you submit to the grader (HTTPS, no trailing slash needed)
PUBLIC_BASE_URL=https://your-app.onrender.com/a2a
# Optional: comma-separated allowed tokens. If unset, any non-empty Bearer token is accepted
# and each distinct token is a separate isolated user.
AGENT_TOKENS=
# Packages per model call (12 = one call per core batch)
CHUNK_SIZE=12
DATA_DIR=./data
